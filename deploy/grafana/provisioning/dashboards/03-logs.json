{
  "uid": "riskio-logs",
  "title": "Riskio \u00b7 Logs",
  "tags": [
    "riskio",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "logs",
      "title": "Logs del backend",
      "gridPos": {
        "h": 14,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "{service_name=~\"riskio-api|riskio-worker\"}",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "type": "logs",
      "title": "Errores",
      "gridPos": {
        "h": 14,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "{service_name=~\"riskio-api|riskio-worker\"} | json | level=~\"error|warn\"",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Logs por nivel y servicio",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (service_name, level) (count_over_time({service_name=~\"riskio-api|riskio-worker\"} | json | __error__=\"\" [5m]))",
          "legendFormat": "{{service_name}} {{level}}"
        }
      ]
    }
  ]
}