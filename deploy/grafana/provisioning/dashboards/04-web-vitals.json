{
  "uid": "riskio-web-vitals",
  "title": "Web Vitals y accesibilidad",
  "description": "Core Web Vitals de usuarios reales (RUM) y resultados de la auditoria de laboratorio. Los percentiles salen de histogramas OTLP; el 75 es el numero que Google puntua.",
  "tags": ["riskio", "web-vitals", "rum", "a11y"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "editable": true,
  "panels": [
    {
      "type": "row",
      "title": "Usuarios reales (RUM)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "LCP p75 ( bueno < 2500 ms )",
      "description": "Percentil 75 del LCP de sesiones reales, por ruta. Es el numero que Google usa para puntuar el sitio.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le, route) (rate(web_vitals_LCP_milliseconds_bucket[1h])))",
          "legendFormat": "{{route}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 2500 },
              { "color": "red", "value": 4000 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "INP p75 ( bueno < 200 ms )",
      "description": "Interaction to Next Paint en sesiones reales. No aparece en Lighthouse: solo se puede medir en el campo.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le, route) (rate(web_vitals_INP_milliseconds_bucket[1h])))",
          "legendFormat": "{{route}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CLS p75 ( bueno < 0.1 )",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le, route) (rate(web_vitals_cls_bucket[1h])))",
          "legendFormat": "{{route}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Sesiones medidas / h",
      "description": "Cuantos usuarios reales han aportado muestras. Si esto es cero, los otros paneles estan vacios por falta de datos y no porque la app vaya bien.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(web_vitals_LCP_milliseconds_count[1h]))",
          "legendFormat": "muestras"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "area"
      },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Clasificacion propia de cada vital (p75 por ruta)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(clamp_max((histogram_quantile(0.75, sum by (le, route) (rate(web_vitals_LCP_milliseconds_bucket[1h]))) / 2500) * 100, 0, 100), 0)",
          "legendFormat": "LCP {{route}}"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LCP p50 / p75 / p95 por ruta",
      "description": "La distancia entre p50 y p95 es la usuarios con equipos lentos. Si solo se mirara p50, esa cola no apareceria.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, route) (rate(web_vitals_LCP_milliseconds_bucket[1h])))",
          "legendFormat": "p50 {{route}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.75, sum by (le, route) (rate(web_vitals_LCP_milliseconds_bucket[1h])))",
          "legendFormat": "p75 {{route}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(web_vitals_LCP_milliseconds_bucket[1h])))",
          "legendFormat": "p95 {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LCP por tipo de dispositivo y navegacion",
      "description": "El movil suele cargar la mitad de ancho de banda. Si la linea de movil esta por encima, la optimizacion que toca es la de red, no la del codigo.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le, viewport) (rate(web_vitals_LCP_milliseconds_bucket[1h])))",
          "legendFormat": "p75 {{viewport}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Auditoria de laboratorio (audit-web.sh)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Lighthouse: LCP, TBT y score de rendimiento",
      "description": "Numero de laboratorio, en una maquina que no es la del usuario. Sirve para ver regresiones entre despliegues, no para puntuar el sitio.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        { "refId": "A", "expr": "audit_lcp_milliseconds", "legendFormat": "LCP ms" },
        { "refId": "B", "expr": "audit_tbt_milliseconds", "legendFormat": "TBT ms" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Puntuaciones de la auditoria",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 15 },
      "targets": [
        { "refId": "A", "expr": "audit_performance_score_ratio", "legendFormat": "rendimiento" },
        { "refId": "B", "expr": "audit_accessibility_score_ratio", "legendFormat": "accesibilidad" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Violaciones de accesibilidad por regla",
      "description": "Un axe por ejecucion. Una regla que aparece de golpe es una regresion; una que sube despacio son nodos nuevos acumulados.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rule) (audit_axe_violations_ratio)",
          "legendFormat": "{{rule}}"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
