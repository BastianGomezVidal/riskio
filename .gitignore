# Rendered by backend/scripts/dev-fixtures.mjs. Its state.json carries the
# advisory counter, and a committed one would make the next advisory number
# depend on who cloned the repo last.
backend/.dev-fixtures/

# Salidas de dev.sh
.dev-logs/

# Deps e informes de audit-web.sh
.audit/node_modules/
.audit/out/
# Los informes Lighthouse son artefactos locales y pueden pesar bastante.
# El historico de runs esta en .audit/lighthouse-run-*.json.
.audit/*.json

# Documentacion local, no compartida.
#
# El README.md de la raiz SI se versiona: es la referencia del proyecto, y lo
# que una persona nueva necesita para levantar esto. Todo lo demas no.
#
# Los archivos siguen en el disco; solo dejan de estar en git. Para volver a
# subirlos, `git add -f <archivo>`.
AGENTS.md
PLAN-ACCION.md
contexto.txt
backend/README.md

# Los ARCHITECTURE-*.md se fusionaron en el README y se borraron del repo. Las
# copias historicas, con el detalle de por que se tomo cada decision, quedan
# fuera de git a proposito: son un registro de lo que se intento y lo que
# fallo, no instruccion para quien llega. Si se necesitan:
#   git show <commit>^:ARCHITECTURE-BACKEND.md
ARCHITECTURE-*.md
