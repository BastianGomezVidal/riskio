POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# API
API_PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/DBNAME

# Containers
BACKEND_API_PORT=3000
WEB_PORT=8080
VITE_API_URL=http://backend-api:3000
REDIS_PORT=6379

# Object storage (S3-compatible).
# The compose file defaults to SeaweedFS, which accepts any credentials, so
# these only need real values when pointing at another provider (MinIO, AWS,
# LocalStack). Leave the endpoint empty to use the real AWS S3 endpoints.
STORAGE_ENDPOINT=http://storage:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=riskio-avatars
STORAGE_ACCESS_KEY=any
STORAGE_SECRET_KEY=any
# Host-visible address the browser uses to load avatars. This is NOT the
# internal endpoint: the API talks to STORAGE_ENDPOINT over the container
# network, while the browser only ever sees this one.
STORAGE_PUBLIC_URL=http://localhost:8333/riskio-avatars

# Cache driver: `memory` or `redis`.
CACHE_DRIVER=redis
REDIS_URL=redis://redis:6379

# NHC Provider
NHC_BASE_URL=https://www.nhc.noaa.gov
NHC_TIMEOUT_MS=10000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m

# Roles: accounts with these emails get the admin role; everyone else is a client.
# Comma separated; empty = every account is a client.
ADMIN_EMAILS=operator@riskio.dev

# OAuth (Google / Outlook): leave the CLIENT_ID/SECRET blank to disable.
# Without credentials the start endpoint answers 503 "<provider> login is not
# configured" and the sign-in page still shows both buttons.
#
# Three URLs, and they are not interchangeable:
#
#   PUBLIC_BASE_URL      public origin of the API
#   API_PUBLIC_BASE_URL  the redirect_uri, WITH the /api prefix nginx serves the
#                        API under. This is the value the provider calls back,
#                        so it must match the console character for character or
#                        the exchange is rejected with redirect_uri_mismatch.
#   FRONTEND_URL         where the browser is sent once the flow finishes
#
# Left empty, API_PUBLIC_BASE_URL falls back to PUBLIC_BASE_URL + /api.
PUBLIC_BASE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# CORS (comma separated origins; empty = allow all)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost
# Outbound email. Only the password reset link uses it today.
#
# MAIL_TRANSPORT=log writes the link to the backend log instead of sending it:
# handy locally, unsafe anywhere real, because a reset link in a log is a
# working credential. The API says so at boot when this is active.
#
# For real delivery set MAIL_TRANSPORT=smtp and fill in the SMTP_* values. The
# API refuses to start on smtp unless HOST, USER, PASS and MAIL_FROM are all
# present, so a typo fails at boot instead of on someone's first reset.
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465), false for STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=riskio@example.com

# Observability. Every port is bound to 127.0.0.1, so none of these is reachable
# from outside the machine. Change the *_PORT values if one collides locally.
GRAFANA_PORT=3001
GRAFANA_USER=admin
# Grafana refuses to start on the default password unless this is set explicitly.
GRAFANA_PASSWORD=change-me
PROMETHEUS_PORT=9090
PUSHGATEWAY_PORT=9091
JAEGER_PORT=16686
OTEL_PORT=4318

# Ports of the seven backend services. Only backend-api and the frontend are
# published on all interfaces; the rest stay on loopback for local debugging.
AUTH_PORT=3008
WEATHER_PORT=3007
FEEDS_PORT=3006
DASHBOARD_PORT=3009
STORAGE_PORT=3004
CACHE_PORT=3005

# Telemetry
DEPLOYMENT_ENVIRONMENT=local
OTEL_SERVICE_NAME=riskio-api
OTEL_AUTH_SERVICE_NAME=riskio-auth
OTEL_WEATHER_SERVICE_NAME=riskio-weather
OTEL_FEEDS_SERVICE_NAME=riskio-feeds
OTEL_DASHBOARD_SERVICE_NAME=riskio-dashboard
OTEL_STORAGE_SERVICE_NAME=riskio-storage
OTEL_CACHE_SERVICE_NAME=riskio-cache
# 0..1. Lower it before going anywhere real; every service exports spans.
OTEL_TRACE_SAMPLE_RATIO=1

# Timeouts between services, in ms.
AUTH_SERVICE_TIMEOUT_MS=5000
WEATHER_SERVICE_TIMEOUT_MS=5000
FEEDS_SERVICE_TIMEOUT_MS=10000
STORAGE_API_TIMEOUT_MS=5000
CACHE_SERVICE_TIMEOUT_MS=1000
# How long the cache service keeps serving reads while Redis is unreachable.
CACHE_SERVICE_COOLDOWN_MS=10000

# Frontend session timeouts, in ms. The warning modal appears this long before
# the idle logout fires.
VITE_IDLE_TIMEOUT_MS=900000
VITE_IDLE_WARNING_MS=60000
