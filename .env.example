POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# API
API_PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/DBNAME

# Containers
BACKEND_API_PORT=3000
WEB_PORT=8080
VITE_API_URL=http://backend-api:3000
REDIS_PORT=6379

# Object storage (S3-compatible).
# The compose file defaults to SeaweedFS, which accepts any credentials, so
# these only need real values when pointing at another provider (MinIO, AWS,
# LocalStack). Leave the endpoint empty to use the real AWS S3 endpoints.
STORAGE_ENDPOINT=http://storage:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=riskio-avatars
STORAGE_ACCESS_KEY=any
STORAGE_SECRET_KEY=any
# Host-visible address the browser uses to load avatars. This is NOT the
# internal endpoint: the API talks to STORAGE_ENDPOINT over the container
# network, while the browser only ever sees this one.
STORAGE_PUBLIC_URL=http://localhost:8333/riskio-avatars

# Cache driver: `memory` or `redis`.
CACHE_DRIVER=redis
REDIS_URL=redis://redis:6379

# Broker driver. Only `memory` is implemented — there is no `redis.broker.ts`, so
# `BROKER_DRIVER=redis` is accepted by the validation schema but has no adapter and
# would drop events silently. See D5 in PLAN-ACCION.md.
BROKER_DRIVER=memory

# NHC Provider
NHC_BASE_URL=https://www.nhc.noaa.gov
NHC_TIMEOUT_MS=10000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m

# Roles: accounts with these emails get the admin role; everyone else is a client.
# Comma separated; empty = every account is a client.
ADMIN_EMAILS=operator@riskio.dev

# OAuth (Google / Outlook): leave the CLIENT_ID/SECRET blank to disable.
# PUBLIC_BASE_URL must match the authorized redirect_uri in the provider console:
#   {PUBLIC_BASE_URL}/auth/oauth/google/callback   and
#   {PUBLIC_BASE_URL}/auth/oauth/outlook/callback
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# CORS (comma separated origins; empty = allow all)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost
# Outbound email. Only the password reset link uses it today.
#
# MAIL_TRANSPORT=log writes the link to the backend log instead of sending it:
# handy locally, unsafe anywhere real, because a reset link in a log is a
# working credential. The API says so at boot when this is active.
#
# For real delivery set MAIL_TRANSPORT=smtp and fill in the SMTP_* values. The
# API refuses to start on smtp unless HOST, USER, PASS and MAIL_FROM are all
# present, so a typo fails at boot instead of on someone's first reset.
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465), false for STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=riskio@example.com
